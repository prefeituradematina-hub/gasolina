rules_version = '2';

/**
 * MODELO DE PROPRIEDADE DE TIME
 * ---------------------------------------------------------------------
 * Cada documento em /times/{timeId} guarda o campo `responsavelUid`
 * (uid do Firebase Auth do responsável). Essa é a fonte da verdade de
 * "qual time pertence a qual usuário" — não usar timeId salvo no
 * documento de usuário para decisões de permissão, para evitar
 * inconsistência caso o vínculo mude.
 *
 * Coleções: usuarios, campeonatos, times, atletas, atletasPrivado, jogos,
 * resultados, artilharia, regulamentos, configuracoes.
 * ---------------------------------------------------------------------
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souAdmin() {
      return logado() &&
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             meuPerfil().tipo == 'admin' &&
             meuPerfil().status == 'ativo';
    }

    function souResponsavelAtivo() {
      return logado() &&
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             meuPerfil().tipo == 'responsavel' &&
             meuPerfil().status == 'ativo';
    }

    function souDonoDoTime(timeId) {
      return souResponsavelAtivo() &&
             exists(/databases/$(database)/documents/times/$(timeId)) &&
             get(/databases/$(database)/documents/times/$(timeId)).data.responsavelUid == request.auth.uid;
    }

    // ---------- usuarios ----------
    // Só o próprio admin gerencia contas. Usuário comum só lê o próprio doc
    // (necessário para o app checar tipo/status após login).
    match /usuarios/{uid} {
      allow read: if souAdmin() || (logado() && request.auth.uid == uid);
      allow create, update, delete: if souAdmin();
    }

    // ---------- campeonatos ----------
    // Leitura pública (página pública do campeonato). Escrita só admin.
    match /campeonatos/{campeonatoId} {
      allow read: if true;
      allow write: if souAdmin();
    }

    // ---------- times ----------
    match /times/{timeId} {
      allow read: if true;

      // Responsável pode CRIAR seu próprio time (autoatribuindo-se como
      // responsavelUid), sempre com status "pendente" — nunca já aprovado.
      allow create: if souResponsavelAtivo() &&
                       request.resource.data.responsavelUid == request.auth.uid &&
                       request.resource.data.status == 'pendente';

      // Responsável só edita dados do PRÓPRIO time, e não pode alterar
      // status, responsavelUid ou campeonatoId (isso é controle do admin).
      allow update: if souAdmin() ||
                      (souDonoDoTime(timeId) &&
                       request.resource.data.responsavelUid == resource.data.responsavelUid &&
                       request.resource.data.status == resource.data.status &&
                       request.resource.data.campeonatoId == resource.data.campeonatoId);

      allow delete: if souAdmin();
    }

    // ---------- atletas ----------
    // Campos públicos/básicos (nome, foto, número, posição, status...).
    // Dados sensíveis (CPF, título de eleitor, foto do documento) NÃO
    // ficam aqui — ver coleção atletasPrivado abaixo, com leitura restrita.
    //
    // status: "pendente" | "aprovado" | "rejeitado" (doc legado sem
    // aprovação explícita pode ter status "ativo" — tratado como
    // aprovado para efeito de exibição, nunca reescrito à força aqui).
    // Só o admin pode aprovar/rejeitar (mudar status/aprovadoPor/aprovadoEm).
    match /atletas/{atletaId} {
      allow read: if true;

      // Responsável só cria atleta do PRÓPRIO time, e sempre como "pendente"
      // (nunca já aprovado). Admin pode criar com qualquer status.
      allow create: if souAdmin() ||
                       (souResponsavelAtivo() &&
                        souDonoDoTime(request.resource.data.timeId) &&
                        request.resource.data.get('status', 'pendente') == 'pendente');

      // Responsável só edita atleta do PRÓPRIO time, não pode trocar de
      // time, e não pode mexer em status/aprovadoPor/aprovadoEm — isso é
      // exclusivo do admin (aprovação/rejeição).
      allow update: if souAdmin() ||
                       (souResponsavelAtivo() &&
                        souDonoDoTime(resource.data.timeId) &&
                        request.resource.data.timeId == resource.data.timeId &&
                        request.resource.data.get('status', null) == resource.data.get('status', null) &&
                        request.resource.data.get('aprovadoPor', null) == resource.data.get('aprovadoPor', null) &&
                        request.resource.data.get('aprovadoEm', null) == resource.data.get('aprovadoEm', null));

      allow delete: if souAdmin() ||
                      (souResponsavelAtivo() && souDonoDoTime(resource.data.timeId));
    }

    // ---------- atletasPrivado ----------
    // CPF, título de eleitor e foto do documento. Doc.id === atletaId
    // (mesmo id do doc correspondente em /atletas). Leitura restrita ao
    // admin e ao responsável dono do time do atleta — nunca pública.
    match /atletasPrivado/{atletaId} {
      function timeIdDoAtleta() {
        return get(/databases/$(database)/documents/atletas/$(atletaId)).data.timeId;
      }
      function souDonoDoAtletaPrivado() {
        return souResponsavelAtivo() &&
               exists(/databases/$(database)/documents/atletas/$(atletaId)) &&
               souDonoDoTime(timeIdDoAtleta());
      }
      allow read, write: if souAdmin() || souDonoDoAtletaPrivado();
    }

    // ---------- jogos ----------
    // Só o admin cadastra/edita jogos e insere resultados. Todos leem.
    match /jogos/{jogoId} {
      allow read: if true;
      allow write: if souAdmin();
    }

    // ---------- resultados (histórico/log, se usado além do campo em jogos) ----------
    match /resultados/{resultadoId} {
      allow read: if true;
      allow write: if souAdmin();
    }

    // ---------- classificacao (cache opcional calculado pelo admin) ----------
    match /classificacao/{docId} {
      allow read: if true;
      allow write: if souAdmin();
    }

    // ---------- artilharia ----------
    match /artilharia/{artilheiroId} {
      allow read: if true;
      allow write: if souAdmin();
    }

    // ---------- regulamentos ----------
    match /regulamentos/{campeonatoId} {
      allow read: if true;
      allow write: if souAdmin();
    }

    // ---------- configuracoes ----------
    // Ex: regras de pontuação, cores do campeonato. Leitura pública,
    // escrita só admin.
    match /configuracoes/{docId} {
      allow read: if true;
      allow write: if souAdmin();
    }
  }
}
